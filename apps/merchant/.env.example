# ==========================================
# 🏪 独立商户门户环境变量配置 (apps/merchant, Vite SPA)
# ==========================================

# 商户全局唯一租户标识 (与平台 businessId 一致)
MERCHANT_ID=aurora

# 商户 SPI 安全鉴权密钥 (用于 HMAC-SHA256 签名校验，需与网关 services/.env 同值;
# 2026-10-15 安全审计:公开示例值视同泄露,openssl rand -hex 32 另起)
MERCHANT_API_SECRET=change-me-to-openssl-rand-hex-32

# 网关地址 (Vite dev server 将 /api/* 与 /spi/* 代理至此, 见 vite.config.ts)
GATEWAY_URL=http://localhost:4000
