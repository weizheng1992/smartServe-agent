# ==========================================
# 🏪 独立商户门户环境变量配置 (apps/merchant, Vite SPA)
# ==========================================

# 商户全局唯一租户标识 (与平台 businessId 一致)。Vite 只向客户端暴露 VITE_
# 前缀变量,src/lib/tenant.ts 经 import.meta.env 读取;缺省 aurora(演示租户)
VITE_MERCHANT_ID=aurora

# ⚠️ SPA 内严禁持有 SPI HMAC 密钥 —— 签名发生在服务端(网关/商户自有后端),
# 此前示例里的 MERCHANT_API_SECRET 在浏览器不可达且零引用,已于 2026-10-17
# 审查移除;密钥真源配置在网关侧 services/.env(见根 .env.example 与
# deploy/.env.prod.example 的 MERCHANT_API_SECRET 条目)

# 网关地址 (Vite dev server 将 /api/* 与 /spi/* 代理至此, vite.config.ts 读
# process.env.GATEWAY_URL —— Node 侧变量,无需 VITE_ 前缀)
GATEWAY_URL=http://localhost:4000
