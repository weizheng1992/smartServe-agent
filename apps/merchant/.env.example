# ==========================================
# 🏪 独立商户服务环境变量配置 (apps/merchant)
# ==========================================

# 商户全局唯一租户标识 (与平台 businessId 一致)
MERCHANT_ID=aurora

# 商户 SPI 安全鉴权密钥 (用于 HMAC-SHA256 签名校验，需与 Admin/平台 tenant_configs 中一致)
MERCHANT_API_SECRET=aurora_secret_key_8899

# 独立商户端服务端口 (默认 3005)
PORT=3005

# 独立商户数据库连接串 (默认连接同一 PG 实例的不同表/库)
MERCHANT_DATABASE_URL=postgres://agent_user:agent_password@localhost:5432/agent_platform
