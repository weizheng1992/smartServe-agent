{
  "name": "agent-platform",
  "version": "0.1.0",
  "private": true,
  "workspaces": ["apps/*", "packages/*"],
  "scripts": {
    "dev": "turbo run dev --filter=web --filter=merchant",
    "dev:server": "bun --filter server dev",
    "dev:services": "turbo run dev --filter=web --filter=merchant",
    "dev:merchant": "bun --filter merchant dev",
    "dev:api": "bun --filter web dev",
    "dev:web": "bun --filter web dev",
    "dev:admin": "bun --filter admin dev",
    "dev:all": "turbo run dev",
    "worker": "bun --filter engine worker",
    "docker:up": "docker compose up -d",
    "docker:temporal": "docker compose --profile temporal up -d",
    "docker:down": "docker compose down",
    "db:push": "bun drizzle-kit push",
    "db:seed": "bun packages/db/src/seed.ts",
    "build": "turbo run build",
    "start": "turbo run start",
    "lint": "turbo run lint",
    "biome:format": "biome format --write .",
    "biome:lint": "biome lint --write .",
    "biome:check": "biome check --write .",
    "test:load": "bun scripts/load-test.ts",
    "test:e2e": "playwright test",
    "test:eval": "bun eval/run-full-e2e-eval.ts",
    "test:prompt": "promptfoo eval -c eval/promptfooconfig.yaml --no-write --no-cache",
    "test:prompt:planner": "promptfoo eval -c eval/promptfoo.planner.yaml --no-write --no-cache",
    "db:clean": "bun packages/db/src/scripts/check-and-clean.ts"
  },
  "devDependencies": {
    "@biomejs/biome": "^1.9.4",
    "@playwright/test": "^1.49.1",
    "@tailwindcss/postcss": "^4.3.2",
    "@tailwindcss/vite": "^4.0.0",
    "@types/node": "^20.0.0",
    "@types/react": "19.0.0",
    "@types/react-dom": "19.0.0",
    "@vitejs/plugin-react-swc": "^3.7.2",
    "autoprefixer": "^10.4.0",
    "bun-types": "latest",
    "drizzle-kit": "^0.31.10",
    "pino-pretty": "^13.1.3",
    "postcss": "^8.4.0",
    "promptfoo": "^0.111.0",
    "tailwindcss": "^4.0.0",
    "turbo": "^2.0.0",
    "typescript": "^5.0.0",
    "vite": "^6.0.0"
  },
  "packageManager": "bun@1.3.14",
  "dependencies": {
    "@langchain/openai": "^1.5.5",
    "clsx": "^2.1.1",
    "tailwind-merge": "^3.6.0"
  }
}
