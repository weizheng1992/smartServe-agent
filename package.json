{
  "name": "agent-platform",
  "version": "2.0.0",
  "private": true,
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "dev": "turbo run dev --filter=web --filter=merchant",
    "dev:server": "cd services/gateway-py && uv run --env-file ../../.env uvicorn gateway_py.main:app --port 4000 --reload",
    "dev:services": "turbo run dev --filter=web --filter=merchant",
    "dev:merchant": "bun --filter merchant dev",
    "dev:api": "bun --filter web dev",
    "dev:web": "bun --filter web dev",
    "dev:admin": "bun --filter admin dev",
    "dev:all": "turbo run dev",
    "worker": "cd services/engine-py && uv run --env-file ../../.env python -m engine_py.temporal.worker",
    "docker:up": "docker compose up -d",
    "docker:temporal": "docker compose --profile temporal up -d",
    "docker:down": "docker compose down",
    "db:push": "cd services/engine-py && uv run --env-file ../../.env alembic upgrade head",
    "db:seed": "cd services/engine-py && uv run --env-file ../../.env python -m engine_py.db.seed && uv run --env-file ../../.env python -m engine_py.db.seed_third_party && cd ../gateway-py && uv run --env-file ../../.env python -m gateway_py.merchant_seed",
    "build": "turbo run build",
    "start": "turbo run start",
    "lint": "turbo run lint",
    "biome:format": "biome format --write .",
    "biome:lint": "biome lint --write .",
    "biome:check": "biome check --write .",
    "test:e2e": "playwright test",
    "test:eval": "cd services/gateway-py && uv run pytest",
    "test:prompt": "promptfoo eval -c eval/promptfooconfig.yaml --no-write --no-cache",
    "test:prompt:planner": "promptfoo eval -c eval/promptfoo.planner.yaml --no-write --no-cache",
    "test:prompt:pin": "bun eval/pinBaselines.ts",
    "test:prompt:compare": "bun eval/compareBaselines.ts"
  },
  "devDependencies": {
    "@biomejs/biome": "^1.9.4",
    "@playwright/test": "^1.49.1",
    "@tailwindcss/postcss": "^4.3.2",
    "@tailwindcss/vite": "^4.0.0",
    "@types/node": "^20.0.0",
    "@types/react": "19.0.0",
    "@types/react-dom": "19.0.0",
    "@vitejs/plugin-react-swc": "^3.7.2",
    "autoprefixer": "^10.4.0",
    "bun-types": "latest",
    "drizzle-kit": "^0.31.10",
    "pino-pretty": "^13.1.3",
    "postcss": "^8.4.0",
    "promptfoo": "^0.111.0",
    "tailwindcss": "^4.0.0",
    "turbo": "^2.0.0",
    "typescript": "^5.0.0",
    "vite": "^6.0.0"
  },
  "packageManager": "bun@1.3.14",
  "dependencies": {
    "@langchain/openai": "^1.5.5",
    "@radix-ui/react-dialog": "^1.1.6",
    "@radix-ui/react-popover": "^1.1.6",
    "clsx": "^2.1.1",
    "cmdk": "^1.0.4",
    "tailwind-merge": "^3.6.0"
  }
}
