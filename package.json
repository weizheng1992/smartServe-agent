{
  "name": "agent-platform",
  "version": "0.1.0",
  "private": true,
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "dev": "turbo run dev",
    "build": "turbo run build",
    "start": "turbo run start",
    "lint": "turbo run lint",
    "biome:format": "biome format --write .",
    "biome:lint": "biome lint --write .",
    "biome:check": "biome check --write .",
    "test:e2e": "playwright test",
    "test:prompt": "promptfoo eval -c eval/promptfooconfig.yaml",
    "db:clean": "bun packages/db/src/scripts/check-and-clean.ts"
  },
  "devDependencies": {
    "@biomejs/biome": "^1.9.4",
    "@playwright/test": "^1.49.1",
    "@tailwindcss/postcss": "^4.3.2",
    "@types/node": "^20.0.0",
    "@types/react": "19.0.0",
    "@types/react-dom": "19.0.0",
    "autoprefixer": "^10.4.0",
    "bun-types": "latest",
    "drizzle-kit": "^0.31.10",
    "eslint": "^8.57.0",
    "eslint-config-next": "^15.1.0",
    "pino-pretty": "^13.1.3",
    "postcss": "^8.4.0",
    "promptfoo": "^0.111.0",
    "tailwindcss": "^4.0.0",
    "turbo": "^2.0.0",
    "typescript": "^5.0.0",
    "web": "workspace:*"
  },
  "packageManager": "bun@1.3.14",
  "dependencies": {
    "@langchain/openai": "^1.5.5",
    "clsx": "^2.1.1",
    "tailwind-merge": "^3.6.0"
  }
}
