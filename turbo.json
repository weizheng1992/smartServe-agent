{
  "$schema": "https://turbo.build/schema.json",
  "globalPassThroughEnv": [
    "DATABASE_URL",
    "REDIS_URL",
    "REDIS_PASSWORD",
    "POSTGRES_USER",
    "POSTGRES_PASSWORD",
    "POSTGRES_DB",
    "AI_BASE_URL",
    "AI_API_KEY",
    "AI_MODEL",
    "AI_EMBEDDING_MODEL",
    "AI_EMBEDDING_PROVIDER",
    "NODE_ENV",
    "GATEWAY_URL",
    "E2E_GATEWAY_TARGET"
  ],
  "tasks": {
    "build": {
      "dependsOn": ["^build"],
      "outputs": ["dist/**"]
    },
    "dev": {
      "cache": false,
      "persistent": true
    },
    "test": {
      "cache": false
    }
  }
}
