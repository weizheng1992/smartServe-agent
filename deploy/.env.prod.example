# 生产环境模板:与根 .env.example 变量一一对齐(地址换成容器内网主机名)
# cp deploy/.env.prod.example deploy/.env.prod && vim deploy/.env.prod
# ⚠️ 三个 change-me-strong 必改;.env.prod 已被 gitignore,永不入库

# ============ AI API Gateway(LLM 端点,必须换) ============
# 本地开发的 127.0.0.1:11211 是本机代理,服务器上不可用——填真实 OpenAI 兼容端点
AI_BASE_URL=https://你的LLM网关/v1
AI_API_KEY=change-me
AI_MODEL=你的模型名
# embedding 提供方:local = 进程内 bge 免费离线(首次启动经 HF_ENDPOINT 下载后缓存到卷);
# openai = 走 AI_BASE_URL 的 /embeddings
AI_EMBEDDING_PROVIDER=local
AI_EMBEDDING_MODEL=BAAI/bge-small-zh-v1.5
AI_MALL_SEMANTIC_ENABLED=1
AI_MALL_SEMANTIC_MIN_SIMILARITY=0.55
AI_MALL_QUERY_REWRITE_ENABLED=1
AI_MALL_QUERY_REWRITE_TIMEOUT_SECONDS=2.0
# 服务器在国内建议保留镜像加速;海外删除此行
HF_ENDPOINT=https://hf-mirror.com

# ============ 数据库(主机名 postgres = compose 服务名) ============
POSTGRES_USER=agent_user
POSTGRES_PASSWORD=change-me-strong
POSTGRES_DB=agent_platform
DATABASE_URL=postgres://agent_user:change-me-strong@postgres:5432/agent_platform

# ============ Redis(主机名 redis) ============
REDIS_PASSWORD=change-me-strong
REDIS_URL=redis://:change-me-strong@redis:6379

# ============ Temporal(仅 --profile temporal 时需要) ============
TEMPORAL_ADDRESS=temporal:7233
TEMPORAL_NAMESPACE=default

# ============ LangSmith 追踪(不用就保持 false) ============
LANGCHAIN_TRACING_V2=false
LANGCHAIN_ENDPOINT=https://api.smith.langchain.com
LANGCHAIN_API_KEY=
LANGCHAIN_PROJECT=agentic-customer-support
LANGSMITH_PROJECT=agent-all-support

# ============ Auth JWT(生产必须换成强随机串!) ============
# openssl rand -hex 32 生成;缺省值网关启动会打告警
AUTH_JWT_SECRET=change-me-to-openssl-rand-hex-32

# ============ 限流(滑动窗口,挂 /api/chat 与 /api/v1/spi) ============
RATE_LIMIT_WINDOW_SECONDS=60
RATE_LIMIT_CHAT_TENANT_MAX=60
RATE_LIMIT_CHAT_IP_MAX=120
RATE_LIMIT_SPI_TENANT_MAX=300
RATE_LIMIT_SPI_IP_MAX=600
# 采信 XFF 的可信反代:流量经 nginx 容器反代,如需按真实客户端 IP 限流,
# 把 nginx 容器所在网段加入(如 172.16.0.0/12);默认仅本机(保守,按反代 IP 计)
RATE_LIMIT_TRUSTED_PROXIES=127.0.0.1,::1
RATE_LIMIT_KEY_PREFIX=ratelimit

# ============ LLM 熔断/退避/超时 ============
LLM_CIRCUIT_MAX_FAILURES=5
LLM_CIRCUIT_COOLDOWN_SECONDS=30
LLM_RETRY_MAX_ATTEMPTS=3
LLM_RETRY_INITIAL_DELAY_MS=1000
LLM_TIMEOUT_SECONDS=120

# 思维链开关:disabled = 注入关闭参数(glm-4.7 系琐碎调用也生成大量 reasoning token,
# 串行多次调用即分钟级回复);换不支持 thinking 参数的提供方时置 enabled 规避 400
AI_THINKING=disabled
# planner 深度规划输出上限,防简单问题生成数千 token 导致降级
AI_PLANNER_MAX_TOKENS=2000

# 视觉模型(多模态图片客服;base_url/key 复用 AI_BASE_URL/AI_API_KEY)
AI_VISION_MODEL=glm-4.6v
AI_VISION_TIMEOUT_SECONDS=30

# ============ 应用 ============
UPLOADS_DIR=/data/uploads
TZ=Asia/Shanghai
