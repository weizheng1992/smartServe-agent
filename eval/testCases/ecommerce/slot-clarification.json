[
  {
    "description": "槽位缺失反问 - 修改地址但未提供订单号与新地址",
    "vars": {
      "input": "我想修改一下收货地址",
      "expectedIntent": "order_modify_address",
      "expectedMissingSlots": ["orderId", "newAddress"],
      "expectClarification": true
    },
    "assert": [
      {
        "type": "javascript",
        "value": "file://scorers/slotClarification.scorer.ts"
      }
    ]
  },
  {
    "description": "槽位部分缺失反问 - 提供订单号但未提供新地址",
    "vars": {
      "input": "订单 ORD-ECOM-889901 帮我改下地址",
      "expectedIntent": "order_modify_address",
      "expectedMissingSlots": ["newAddress"],
      "expectClarification": true
    },
    "assert": [
      {
        "type": "javascript",
        "value": "file://scorers/slotClarification.scorer.ts"
      }
    ]
  },
  {
    "description": "槽位完整执行 - 同时提供订单号与详细新地址",
    "vars": {
      "input": "请帮我把订单 ORD-ECOM-889901 的收货地址改成 北京市海淀区中关村南大街1号院3号楼802室",
      "expectedIntent": "order_modify_address",
      "expectedMissingSlots": []
    },
    "assert": [
      {
        "type": "javascript",
        "value": "file://scorers/slotClarification.scorer.ts"
      }
    ]
  },
  {
    "description": "售后槽位缺失反问 - 仅表达退货意图未提供订单号",
    "vars": {
      "input": "我要申请退货退款",
      "expectedIntent": "order_return",
      "expectedMissingSlots": ["orderId"],
      "expectClarification": true
    },
    "assert": [
      {
        "type": "javascript",
        "value": "file://scorers/slotClarification.scorer.ts"
      }
    ]
  }
]
