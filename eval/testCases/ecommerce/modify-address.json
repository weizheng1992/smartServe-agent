      "expectClarification": true
    },
    "assert": [
      {
        "type": "javascript",
        "value": "file://scorers/slotClarification.scorer.ts"
      }
    ]
  },
  {
    "description": "修改地址 - 缺新地址即时反问",
    "vars": {
      "input": "订单 ORD-ECOM-889901 帮我改下地址",
      "expectedIntent": "order_modify_address",
      "expectedMissingSlots": ["newAddress"],
      "expectClarification": true
    },
    "assert": [
      {
        "type": "javascript",
        "value": "file://scorers/slotClarification.scorer.ts"
      }
    ]
  },
  {
    "description": "修改地址 - 槽位完整即时执行 (改到/改成/送至)",
