# ============ AI API Gateway Configuration ============
# ⚠️ AI_BASE_URL / AI_MODEL 必填(persona-hardening 09):缺失或空值时 LLM 首用
# 与网关/Worker 启动即 ConfigError 拒启点名,不再静默回退 TS 时代的死端口缺省。
# 复制本文件后必须填真实 OpenAI 兼容端点与模型名(如 bigmodel coding 端点)。
AI_BASE_URL=
AI_API_KEY=dummy
AI_MODEL=
# embedding 提供方:local = 进程内 sentence-transformers 本地推理(免费离线);
# openai = 走 AI_BASE_URL 的 /embeddings(bigmodel 需 embedding-3 + 账号资源包)
AI_EMBEDDING_PROVIDER=local
AI_EMBEDDING_MODEL=BAAI/bge-small-zh-v1.5
# L2 商品语义召回:词元检索查空时 bge 余弦补位;嵌入不可用自动降级诚实空
AI_MALL_SEMANTIC_ENABLED=1
AI_MALL_SEMANTIC_MIN_SIMILARITY=0.55
# L4 查询改写:词元+语义双空时,LLM 以货架品类词表为锚改写重试一次;
# 超时/异常降级空表,检索链终点仍是诚实空
AI_MALL_QUERY_REWRITE_ENABLED=1
AI_MALL_QUERY_REWRITE_TIMEOUT_SECONDS=2.0
# 货架词典解析器(ADR-0012):导购检索词产出块内词典最长匹配,修饰词只剥不扬;
# off/异常/零产出整句回退旧词元路;DIFF 为观察期对拍日志,期满拆默认
AI_GUIDE_PARSER=1
AI_GUIDE_PARSER_DIFF=1

# ============ Database Configuration (Shared & Docker) ============
POSTGRES_USER=agent_user
POSTGRES_PASSWORD=agent_password
POSTGRES_DB=agent_platform
DATABASE_URL=postgres://agent_user:agent_password@localhost:5432/agent_platform

# ============ Cache Configuration ============
REDIS_PASSWORD=redis_password
REDIS_URL=redis://:redis_password@127.0.0.1:6379

# ============ LangSmith Observability Tracing ============
LANGCHAIN_TRACING_V2=true
LANGCHAIN_ENDPOINT=https://api.smith.langchain.com
LANGCHAIN_API_KEY=key
LANGCHAIN_PROJECT=agentic-customer-support


LANGSMITH_PROJECT="agent-all-support"

# ============ Auth JWT (wayfinder 001) ============
# 生产必须显式注入;缺省密钥仅限本地/E2E(网关启动时打印告警)
AUTH_JWT_SECRET=change-me-in-production

# ============ Rate Limiting (wayfinder 002) ============
# 滑动窗口秒数与租户/IP 双维阈值(挂 /api/chat、/spi/v1 与 /api/store 三面)
RATE_LIMIT_WINDOW_SECONDS=60
RATE_LIMIT_CHAT_TENANT_MAX=60
RATE_LIMIT_CHAT_IP_MAX=120
RATE_LIMIT_SPI_TENANT_MAX=300
RATE_LIMIT_SPI_IP_MAX=600
RATE_LIMIT_STORE_TENANT_MAX=120
RATE_LIMIT_STORE_IP_MAX=240
# XFF 采信的可信反代清单(逗号分隔);共享 Redis 隔离环境换键前缀
RATE_LIMIT_TRUSTED_PROXIES=127.0.0.1,::1
RATE_LIMIT_KEY_PREFIX=ratelimit

# ============ LLM 熔断/退避/超时 (wayfinder 003) ============
LLM_CIRCUIT_MAX_FAILURES=5
LLM_CIRCUIT_COOLDOWN_SECONDS=30
LLM_RETRY_MAX_ATTEMPTS=3
LLM_RETRY_INITIAL_DELAY_MS=1000
LLM_TIMEOUT_SECONDS=120

# 思维链开关(2026-09-09):glm-4.7 默认开 thinking,琐碎调用也先生成大量
# reasoning token(同题 79.9s vs 关闭 7.5-18s),客服管线串行多次调用即分钟级
# 回复。disabled(默认)= 经 extra_body 注入关闭参数;enabled = 不注入(模型
# 默认);换不支持 thinking 参数的提供方时置 enabled 规避 400。
AI_THINKING=disabled
# planner 深度规划输出上限(2026-09-09):曾对「退货政策」类简单问题生成
# 5163 token(73.7s);截断 JSON 落 planner 兜底单步计划(降级不炸会话)
AI_PLANNER_MAX_TOKENS=2000

# 视觉模型(多模态图片客服,wayfinder multimodal 001):glm-4.6v 主力 / glm-4.6v-flash 免费档;
# base_url/key 复用 AI_BASE_URL/AI_API_KEY;结构化输出走 function_calling(4.6V 无 response_format)
AI_VISION_MODEL=glm-4.6v
AI_VISION_TIMEOUT_SECONDS=30

# LLM 总预算闸(2026-09):单请求 LLM 总耗时硬顶(秒),供应商侧悬死不再拖成分钟级 loading
LLM_TOTAL_DEADLINE_SECONDS=180

# ============ 数据分析 Agent (analytics / data-agent) ============
# 结果缓存 TTL 秒(0 = 关,缺省)。键含商户作用域 + 图型指令(2026-09-26 起),
# 不同商户/不同图型不共享缓存
AI_RESULT_CACHE_TTL=0
# 指标分类小模型三态灰度:off(缺省)| shadow | on —— bge + 线性头;
# 产物缺失/加载失败响亮降级为不启用,绝不静默
#AI_METRIC_HEAD=off
#AI_METRIC_HEAD_DIR=training_runs/metric_head
AI_METRIC_HEAD_THRESHOLD=0.5
# L2 意图范例检索超时秒(triage exemplar 检索;超时诚实跳过不阻断)
AI_EXEMPLAR_TIMEOUT_SECONDS=0.2
# L0 意图分类器实现:anchor(缺省,词表锚定)| 未注册实现显式报错不静默回落
#AI_INTENT_CLASSIFIER=anchor

# ============ 商户真库 (agent_merchant) ============
# 商户真单/商品/券独立库;未设时回落 DATABASE_URL 同实例换库名 agent_merchant
MERCHANT_DATABASE_URL=postgres://agent_user:agent_password@localhost:5432/agent_merchant
MERCHANT_ID=aurora
# 商户门户 API-Key/HMAC 共享密钥:MERCHANT_API_SECRET 优先,回落 API_SECRET;
# 2026-10-15 安全审计:公开示例值视同泄露,openssl rand -hex 32 另起 ——
# 验签 fail-closed,不配置则 /spi/v1/* 拒绝全部签名请求
MERCHANT_API_SECRET=change-me-to-openssl-rand-hex-32
#API_SECRET=
# SPI 静态 API-Key 集(逗号分隔;缺省 test_spi_key,master_platform_key;
# key_{tenant}/secret_{tenant} 派生形与 HMAC 签名通道不受此集影响)
SPI_API_KEYS=test_spi_key,master_platform_key

# ============ 网关与引擎杂项 ============
# 网关监听端口(uvicorn 启动读取)
PORT=4000
# JWT 有效期天数(无刷新;登出走 Redis jti 黑名单)
AUTH_TOKEN_TTL_DAYS=30
# 周期任务总开关(outbox 对账 30s / 坏例池摘要 6h;单实例假设,0 = 关闭)
ENGINE_SCHEDULER_ENABLED=1
# 播种是否写入内置演示租户(0 = 只建结构不种演示数据)
SEED_BUILTIN_TENANTS=true
# 商户真账播种环境隔离闸(2026-10-18):非空显式开启才允许执行 merchant_seed
# (脚本会清空重插 agent_merchant 商户真账库,误跑即污染销量聚合;db:seed 与测试
# 夹具各自 opt-in;本地播种临时置 1,切勿长期开启)
#MERCHANT_SEED_ALLOW=
# RAG 知识文件根目录(缺省仓库内 docs/knowledge;容器部署 docs 不在仓库内时显式指定)
#RAG_KNOWLEDGE_DIR=
# 文档 RAG(docling 解析 PDF/Word)插图 VLM 字幕开关(0 = 关,批量离线导入省视觉调用;
# 关闭或失败时图片切片字幕降级为「未生成图片描述」,检索靠章节标题兜底)
#RAG_DOC_VLM_CAPTION=1
# 文档 RAG 的 granite-vision 图表抽数层(1 = 开;仅作用 PDF 管线,bar/pie/line 图表
# 读数为结构化数据,聚合结果带读数误差标注)。缺省关:预设模型权重数 GB(HF 镜像
# 下载)+ 逐图 VLM 推理均在网关进程内,属显式运维决策;docx 原生图表走无损路径不依赖本层
#RAG_DOC_CHART_EXTRACTION=0
# 抽数预设(RAG_DOC_CHART_EXTRACTION=1 时生效):granite_vision_v3_3 = Chart2CSV 专用
# 2B(基准 60.1,缺省)| granite_vision_v4 = 4.1-4B 全能预设
#RAG_DOC_CHART_PRESET=granite_vision_v3_3
# 聊天图片上传目录(缺省仓库根 public/uploads;/api/uploads StaticFiles 回读;测试隔离可覆写)
#UPLOADS_DIR=
